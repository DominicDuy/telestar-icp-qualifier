    {
      "parameters": {
        "jsCode": "\nconst rows = $input.all();\nconst colAliases = ['website','url','domain','homepage','site','company url','company website'];\nconst websiteCol = Object.keys(rows[0].json).find(k => colAliases.some(alias => k.toLowerCase().includes(alias)));\nif (!websiteCol) throw new Error('No website column found. Expected one of: Website, URL, Domain, Homepage, Site');\nconst seen = new Set();\nconst results = [];\nconst chatId = $('Telegram Trigger').first().json.message.chat.id;\nfor (let i = 0; i < rows.length; i++) {\n  const raw = rows[i].json[websiteCol] || '';\n  const normalized = raw.toLowerCase().replace(/^https?:\\/\\//, '').replace(/^www\\./, '').replace(/\\/.*$/, '').trim();\n  if (!normalized || !normalized.includes('.')) continue;\n  results.push({ json: { ...rows[i].json, website: normalized, _is_first_occurrence: !seen.has(normalized), _row_index: i, source_type: 'file_upload', _chat_id: chatId } });\n  seen.add(normalized);\n}\nreturn results;"
      },
      "id": "9a402531-5135-41d1-b621-d03344e976ed",
      "name": "File Parser",
      "type": "n8n-nodes-base.code",
