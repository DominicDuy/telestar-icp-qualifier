    {
      "parameters": {
        "jsCode": "\nconst text = $json.message?.text || $json.result?.text || '';\nconst urlRegex = /(?:https?:\\/\\/)?(?:www\\.)?([a-zA-Z0-9][-a-zA-Z0-9]*\\.[a-zA-Z]{2,}(?:\\.[a-zA-Z]{2,})?)/g;\nconst matches = [...text.matchAll(urlRegex)];\nconst websites = matches.map(m => m[1].toLowerCase().replace(/\\/$/, ''));\nconst unique = [...new Set(websites)];\nif (unique.length === 0) throw new Error('No websites found in your message.');\nreturn unique.map(site => ({\n  json: { website: site, source_type: 'text_message', original_row: null, _chat_id: $('Telegram Trigger').first().json.message.chat.id }\n}));"
      },
      "id": "58f2a290-92a7-4d36-ac27-47a0f92c6def",
