      "id": "1681e8ce-f751-4722-88db-fd0aa900c691",
      "name": "Count Check",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        48,
        1088
      ]
    },
    {
      "parameters": {
        "jsCode": "const items=$input.all();\nconst pass=items.filter(i=>i.json.icp_result==='PASS');\nconst review=items.filter(i=>i.json.icp_result==='REVIEW');\nconst fail=items.filter(i=>i.json.icp_result==='FAIL');\nconst chatId=items[0]?.json._chat_id;\nconst truncated=items[0]?.json._batch_truncated;\nconst totalCount=items[0]?.json._total_unique_count||items.length;\nconst fmt=(item,emoji)=>emoji+' '+item.json.website+' — '+item.json.icp_reasoning;\nlet msg='ICP Check ('+items.length+(truncated?' of '+totalCount:'')+' websites)\\n\\n';\nif(pass.length)msg+=pass.map(i=>fmt(i,'✅')).join('\\n')+'\\n\\n';\nif(review.length)msg+=review.map(i=>fmt(i,'🔵')).join('\\n')+'\\n\\n';\nif(fail.length)msg+=fail.map(i=>fmt(i,'❌')).join('\\n')+'\\n\\n';\nif(truncated)msg+='⚠️ Showing first '+items.length+' of '+totalCount+'\\n';\nmsg+='✅ '+pass.length+' PASS | 🔵 '+review.length+' REVIEW | ❌ '+fail.length+' FAIL';\n\n\nreturn[{json:{text:msg,chat_id:chatId}}];"
      },
